TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEY_2=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_URL=sqlite:///supplydemand_bot.db

# cTrader Open API (market data only) -- primary historical source, see
# scripts/build_from_ctrader_m1.py. CT_CLIENT_ID/CT_CLIENT_SECRET can be the
# same Open API application as harmonic_bot (copy from
# harmonic_bot/executor/.env); that's just an app registration, not a
# trading credential. Then run `python -m core.feeds.ctrader_auth` to get
# this project's OWN tokens (read-only "accounts" scope) -- never paste
# another bot's access/refresh tokens here.
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_REDIRECT_URI=http://localhost:9998/callback
CT_ENV=demo
CT_ACCOUNT_ID=
